# 复制为 .env 后填写。不要提交真实密钥。
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
MINERU_TOKEN=

# 默认只监听服务器本机，由 Tailscale 或反向代理访问。
TIDEBRIEF_BIND=127.0.0.1
TIDEBRIEF_PORT=8765
INFOCOLLECTOR_LOG_LEVEL=INFO

# 可选：若通过带 HTTPS 的反向代理访问，可启用 HTTP Basic 认证。
TIDEBRIEF_USERNAME=
TIDEBRIEF_PASSWORD=

# 可选：部分官方站点会限制数据中心 IP，可为采集器配置代理。
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost

# 可选：Healthchecks.io 或自托管兼容服务的 ping URL。
HEALTHCHECKS_PING_URL=
